# =============================================================================
# Optimal Platform - Local Development Environment
# =============================================================================
# This file provides sensible defaults for local Docker Compose development
# Copy to .env for immediate use: cp env.development .env
# =============================================================================

# -----------------------------------------------------------------------------
# Core Services (Docker Compose internal networking)
# -----------------------------------------------------------------------------

# Database (uses docker-compose service names)
POSTGRES_DB=optimal_platform
POSTGRES_USER=optimal_user
POSTGRES_PASSWORD=dev_password_123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://optimal_user:dev_password_123@postgres:5432/optimal_platform

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# API Gateway
INGESTION_TOKEN=dev-ingestion-token-456
GITLAB_WEBHOOK_SECRET=dev-webhook-secret-123

# Service URLs (internal Docker network)
SBOM_SERVICE_URL=http://sbom-service:8002
VULN_SERVICE_URL=http://vuln-service:8000
GITLAB_LISTENER_URL=http://gitlab-listener:8001

# Frontend (uses docker-compose service name for backend calls)
NEXT_PUBLIC_API_BASE=http://api-gateway:8000

# -----------------------------------------------------------------------------
# GitLab Integration (Optional)
# -----------------------------------------------------------------------------

# GitLab Personal Access Token
# Create at: https://gitlab.com/-/user_settings/personal_access_tokens
# Scopes: api, read_repository, write_repository
# Leave blank to use mock/seeded data
GITLAB_TOKEN=

# GitLab Configuration
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECT_ID=

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------

# JWT Configuration (development only - NOT for production!)
JWT_SECRET_KEY=dev-jwt-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Keycloak SSO (disabled by default in development)
ENABLE_KEYCLOAK=false
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=optimal
KEYCLOAK_CLIENT_ID=optimal-platform
KEYCLOAK_CLIENT_SECRET=dev-client-secret

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------

NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------

# Prometheus (access at http://localhost:9090)
PROMETHEUS_URL=http://prometheus:9090

# Grafana (access at http://localhost:3001, default admin/admin)
GRAFANA_URL=http://grafana:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# External Service Integrations (Optional - leave blank for development)
# -----------------------------------------------------------------------------

# Harbor Container Registry
HARBOR_URL=
HARBOR_USERNAME=
HARBOR_PASSWORD=

# HashiCorp Vault
VAULT_URL=
VAULT_TOKEN=

# Jira
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=

# Confluence
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# Rocket.Chat
ROCKETCHAT_URL=
ROCKETCHAT_USERNAME=
ROCKETCHAT_PASSWORD=

# ArgoCD
ARGO_URL=

# -----------------------------------------------------------------------------
# Development Features
# -----------------------------------------------------------------------------

# Enable detailed request logging
DEBUG_API_REQUESTS=true

# Enable hot reload
WATCH_FILES=true

# Disable HTTPS requirement for development
FORCE_HTTPS=false
