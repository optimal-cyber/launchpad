# =============================================================================
# Optimal Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment
# For local development, see .env.development
# =============================================================================

# -----------------------------------------------------------------------------
# Core Services
# -----------------------------------------------------------------------------

# Database Configuration
POSTGRES_DB=optimal_platform
POSTGRES_USER=optimal_user
POSTGRES_PASSWORD=optimal_pass_CHANGE_ME_IN_PRODUCTION
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://optimal_user:optimal_pass_CHANGE_ME_IN_PRODUCTION@postgres:5432/optimal_platform

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# API Gateway
INGESTION_TOKEN=opt-123456789-CHANGE_ME
GITLAB_WEBHOOK_SECRET=webhook-secret-CHANGE_ME

# Service URLs (internal Docker network)
SBOM_SERVICE_URL=http://sbom-service:8002
VULN_SERVICE_URL=http://vuln-service:8000
GITLAB_LISTENER_URL=http://gitlab-listener:8001

# Frontend
NEXT_PUBLIC_API_BASE=http://api-gateway:8000

# -----------------------------------------------------------------------------
# Integration Provider Selection
# -----------------------------------------------------------------------------
# Choose your CI/CD and ticketing provider: "gitlab" or "github"
# If not set, auto-detects based on which token is configured
OPTIMAL_PROVIDER=gitlab

# -----------------------------------------------------------------------------
# GitLab Integration (if using GitLab)
# -----------------------------------------------------------------------------

# GitLab Personal Access Token (required for GitLab features)
# For self-hosted: Create at: https://your-gitlab.com/-/user_settings/personal_access_tokens
# Scopes needed: api, read_repository, write_repository
GITLAB_TOKEN=

# GitLab Configuration
GITLAB_BASE_URL=http://gitlab:80
GITLAB_PROJECT_ID=

# GitLab Issue Configuration
GITLAB_VULN_LABEL=vulnerability
GITLAB_MISCONFIG_LABEL=misconfiguration
GITLAB_POAM_LABEL=poam
GITLAB_AUTO_LABEL=auto-created
GITLAB_DEFAULT_ASSIGNEE=

# GitLab SLA Configuration (days until due date by severity)
GITLAB_SLA_CRITICAL_DAYS=7
GITLAB_SLA_HIGH_DAYS=30
GITLAB_SLA_MEDIUM_DAYS=90
GITLAB_SLA_LOW_DAYS=180

# -----------------------------------------------------------------------------
# GitHub Integration (if using GitHub)
# -----------------------------------------------------------------------------

# GitHub Personal Access Token
# For GitHub Enterprise: Create at: https://your-github.com/settings/tokens
# Scopes needed: repo, workflow, admin:org (for org repos)
GITHUB_TOKEN=

# GitHub Configuration
# For GitHub Enterprise Server, set to your instance URL
GITHUB_API_URL=https://api.github.com
GITHUB_ORG=
GITHUB_REPO=

# GitHub Issue Configuration
GITHUB_VULN_LABEL=vulnerability
GITHUB_MISCONFIG_LABEL=misconfiguration
GITHUB_POAM_LABEL=poam
GITHUB_AUTO_LABEL=auto-created
GITHUB_DEFAULT_ASSIGNEE=

# GitHub SLA Configuration (days until due date by severity)
GITHUB_SLA_CRITICAL_DAYS=7
GITHUB_SLA_HIGH_DAYS=30
GITHUB_SLA_MEDIUM_DAYS=90
GITHUB_SLA_LOW_DAYS=180

# GitHub Webhook Secret (for verifying incoming webhooks)
GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-CHANGE_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Keycloak SSO (Optional - only needed for enterprise SSO)
# Set ENABLE_KEYCLOAK=true to activate
ENABLE_KEYCLOAK=false
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=optimal
KEYCLOAK_CLIENT_ID=optimal-platform
KEYCLOAK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------

NODE_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------

# Prometheus
PROMETHEUS_URL=http://prometheus:9090

# Grafana
GRAFANA_URL=http://grafana:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_CHANGE_ME

# -----------------------------------------------------------------------------
# External Service Integrations (Optional)
# -----------------------------------------------------------------------------

# Harbor Container Registry
HARBOR_URL=
HARBOR_USERNAME=
HARBOR_PASSWORD=

# HashiCorp Vault
VAULT_URL=
VAULT_TOKEN=

# Jira
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=

# Confluence
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# Rocket.Chat
ROCKETCHAT_URL=
ROCKETCHAT_USERNAME=
ROCKETCHAT_PASSWORD=

# ArgoCD
ARGO_URL=

# -----------------------------------------------------------------------------
# Security Scanning (Optional)
# -----------------------------------------------------------------------------

# Trivy
TRIVY_URL=

# Nessus
NESSUS_URL=
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=

# Tenable.io
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=

# Snyk
SNYK_TOKEN=

# -----------------------------------------------------------------------------
# Cloud Provider Configuration (for production deployments)
# -----------------------------------------------------------------------------

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GCP
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

